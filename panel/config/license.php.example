<?php
// =============================================================================
//  license.php.example - Chaves da licença offline. NÃO VAI PARA O GIT.
//
//  Copie para config/license.php ou, mais fácil, gere com:
//
//      php panel/bin/license.php keygen
//
//  O comando cria o par, grava este arquivo e mostra a chave PÚBLICA para você
//  embarcar no APK (build.gradle.kts → otmLicensePub).
//
//  Alternativa: defina OTM_LICENSE_PUBLIC / OTM_LICENSE_SECRET no ambiente.
// =============================================================================

return [
    // Chave pública Ed25519 (base64) — vai no APK, pode ser pública.
    'public' => getenv('OTM_LICENSE_PUBLIC') ?: '',

    // Chave privada Ed25519 (base64) — só o servidor tem. Nunca publique.
    'secret' => getenv('OTM_LICENSE_SECRET') ?: '',
];
