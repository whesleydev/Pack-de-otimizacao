# arquivos pesados / gerados não versionados
*.apk
*.apks
*.zip
*.7z
*.rar
monster-ap10x-debug.apk

# dumps de conversa (não fazem parte do pack)
conversation_*.zip
event_*.json

# temporários
.agent_tmp/
scratch/
*.tmp
*.log
.DS_Store

# build do Android (gerado)
local.properties
.gradle/
app/build/
build/

# releases empacotados
releases/*.zip
releases/*.zip.sha256

# estado local do painel web (chaves de acesso e log)
web/.token
web/.state/
web/auth.json
web/keys.json
app/src/main/assets/panel/keys.json

# estado local dos plugins
"00 Otimizações/Plugins AxManager"/*/state/
"00 Otimizações/Plugins AxManager"/*/*/state/
"00 Otimizações/Plugins AxManager"/*/*/loop.log
"00 Otimizações/Plugins AxManager"/*/*/webroot/state/

# backup local com dumps de conversa e módulos de terceiros (não versionar)
apps_otm.zip

# credenciais locais do painel (nunca versionar)
panel/config/turso.php
panel/config/license.php
panel/config/vault.php
panel/config/*.local.php

# banco local do painel (modo offline/dev)
panel/database/*.sqlite
panel/database/*.sqlite-wal
panel/database/*.sqlite-shm
