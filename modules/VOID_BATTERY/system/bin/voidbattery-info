#!/system/bin/sh
echo ""
echo "  VOID BATTERY v9.1"
echo "  ═════════════════"

_l=$(dumpsys battery 2>/dev/null | grep 'level:' | sed 's/[^0-9]//g')
_tr=$(dumpsys battery 2>/dev/null | grep 'temperature:' | sed 's/[^0-9]//g')
_t=$(( ${_tr:-300} / 10 ))
_s=$(dumpsys battery 2>/dev/null | grep 'status:' | sed 's/[^0-9]//g')
_v=$(dumpsys battery 2>/dev/null | grep 'voltage:' | sed 's/[^0-9]//g')

case "$_s" in
    2) _st="Charging" ;; 3) _st="Discharging" ;; 5) _st="Full" ;; *) _st="Unknown" ;;
esac

echo "  Battery: ${_l}% | ${_st}"
echo "  Temp: ${_t}C | Voltage: ${_v}mV"
echo ""
