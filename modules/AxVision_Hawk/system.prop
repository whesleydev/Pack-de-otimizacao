#!/system/bin/sh
# This file will be read by setprop
# Example: Change dpi
# ro.sf.lcd_density=320

# SurfaceFlinger Opti
debug.sf.multithreaded_present=1
debug.sf.no_vsyncs_on_screen_off=1

# Hwui Opti
debug.hwui.use_partial_updates=true
debug.hwui.skip_eglmanager_telemetry=true

# Render Engine
debug.renderengine.graphite=true
debug.renderengine.restore_blur_step=false

# Smooth UI & Ram Opt
sys.use_fifo_ui=1
persist.sys.purgeable_assets=1